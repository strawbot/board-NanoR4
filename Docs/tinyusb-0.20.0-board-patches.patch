+// Board patch (not upstream). The hardware does complete the SET_ADDRESS
+// wire transaction itself and latches USBADDR, and it DOES set INTSTS0.DVST
+// for the Default->Address transition (RA4M1 manual R01UH0887EJ0110,
+// Fig. 27.15) -- an earlier version of this comment claimed SET_ADDRESS
+// raised no interrupt at all; the manual says otherwise. What actually
+// made this dispatch path (dcd_int_handler's DVST/DVSQ=Address case)
+// unreachable was that the USBFS interrupt stopped being delivered:
+// USBFS_USBI is the OR of every enabled INTSTS0 status bit through an
+// edge/level detector (Fig. 27.11), so one enabled bit left set when the
+// ISR returns keeps the aggregate high and hides every later event. See
+// Board/usb_init.c's usbfs_int_isr() (service, clear ICU IR, re-check,
+// loop), usb_action() (scheduler poll backstop) and Docs/usb-handoff.md.
+//
+// checkpoint 1 = entered, extra = addr. checkpoint 2 = about to dispatch
+// the synthetic SET_ADDRESS event.
 static void process_set_address(uint8_t rhport)
 {
   rusb2_reg_t* rusb = RUSB2_REG(rhport);
   const uint16_t addr = rusb->USBADDR_b.USBADDR;
+
+  // One-shot per address value: dcd_int_handler() dispatches here on every
+  // DVST interrupt where DVSQ reads Address, which without this guard
+  // would re-fire the synthetic event below on every such interrupt after
+  // the first (e.g. a later bus reset back to Default and re-addressing),
+  // flooding TinyUSB's 16-slot event queue.
+  static uint16_t last_notified_addr;
+  if (addr == last_notified_addr) return;
+
   if (!addr) return;
 
+  last_notified_addr = addr;
+
+  // Belt-and-suspenders: usbd.c's own control-transfer completion should
+  // re-arm DCPCTR (PID=BUF) via its status-stage ZLP send regardless of
+  // this hardware's autonomous handling, but explicitly re-arm here too
+  // and clear the stale VALID bit left by the original SETUP packet, in
+  // case that completion path doesn't run for a request this hardware
+  // has already answered at the wire level. Matches what
+  // process_setup_packet()/pipe0_xfer_in() do for a normally-interrupted
+  // transfer.
+  rusb->INTSTS0 = ~((uint16_t) RUSB2_INTSTS0_VALID_Msk);
+  rusb->DCPCTR  = RUSB2_PIPE_CTR_PID_BUF;
+
   const tusb_control_request_t setup_packet = {
 #if defined(__CCRX__)
       .bmRequestType = { 0 },  /* Note: CCRX needs the braces over this struct member */
@@ -951,6 +1003,7 @@ void dcd_int_handler(uint8_t rhport)
 
   uint16_t is0 = rusb->INTSTS0;
 
+
   /* clear active bits except VALID (don't write 0 to already cleared bits according to the HW manual) */
   rusb->INTSTS0 = ~((RUSB2_INTSTS0_CTRT_Msk | RUSB2_INTSTS0_DVST_Msk | RUSB2_INTSTS0_SOFR_Msk |
                      RUSB2_INTSTS0_RESM_Msk | RUSB2_INTSTS0_VBINT_Msk) & is0) | RUSB2_INTSTS0_VALID_Msk;
