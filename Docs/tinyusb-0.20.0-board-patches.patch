+// Board patch (not upstream TinyUSB): every register-readback spin below was
+// unbounded. All of them are reachable synchronously from dcd_int_handler()
+// (ISR context) via process_bus_reset()/pipe_xfer_in()/pipe_xfer_out() on a
+// real bus reset or data-stage transfer -- exactly what happens the moment a
+// host starts enumerating. If the hardware condition being polled for ever
+// fails to assert (observed: total board freeze, no other code runs at all,
+// specifically during the DFU-bootloader-to-app handoff -- see
+// Docs/usb-handoff.md on board-NanoR4), the CPU spins forever inside the ISR
+// with everything else starved, indistinguishable from a hang. Bounded so a
+// bad transfer can't take the whole board down; on the normal/fast path this
+// changes nothing.
+#define RUSB2_SPIN_TIMEOUT 100000u
+
 static inline void pipe_wait_for_ready(rusb2_reg_t * rusb, unsigned num) {
-  while ( rusb->D0FIFOSEL_b.CURPIPE != num ) {}
-  while ( !rusb->D0FIFOCTR_b.FRDY ) {}
+  uint32_t to = RUSB2_SPIN_TIMEOUT;
+  while ( rusb->D0FIFOSEL_b.CURPIPE != num && --to ) {}
+  to = RUSB2_SPIN_TIMEOUT;
+  while ( !rusb->D0FIFOCTR_b.FRDY && --to ) {}
 }
 
 //--------------------------------------------------------------------+
@@ -341,7 +356,7 @@ static bool pipe_xfer_in(rusb2_reg_t* rusb, unsigned num)
   }
 
   rusb->D0FIFOSEL = 0;
-  while (rusb->D0FIFOSEL_b.CURPIPE) {} /* if CURPIPE bits changes, check written value */
+  { uint32_t to = RUSB2_SPIN_TIMEOUT; while (rusb->D0FIFOSEL_b.CURPIPE && --to) {} } /* if CURPIPE bits changes, check written value */
 
   pipe->remaining = rem - len;
 
@@ -375,7 +390,7 @@ static bool pipe_xfer_out(rusb2_reg_t* rusb, unsigned num)
   }
 
   rusb->D0FIFOSEL = 0;
-  while (rusb->D0FIFOSEL_b.CURPIPE) {} /* if CURPIPE bits changes, check written value */
+  { uint32_t to = RUSB2_SPIN_TIMEOUT; while (rusb->D0FIFOSEL_b.CURPIPE && --to) {} } /* if CURPIPE bits changes, check written value */
 
   pipe->remaining = rem - len;
   if ((len < mps) || (rem == len)) {
@@ -426,11 +441,11 @@ static bool process_pipe0_xfer(rusb2_reg_t* rusb, int buffer_type, uint8_t ep_ad
     /* IN, 2 bytes */
     rusb->CFIFOSEL = RUSB2_CFIFOSEL_ISEL_WRITE | RUSB2_FIFOSEL_MBW_16BIT |
                      (TU_BYTE_ORDER == TU_BIG_ENDIAN ? RUSB2_FIFOSEL_BIGEND : 0);
-    while ( !(rusb->CFIFOSEL & RUSB2_CFIFOSEL_ISEL_WRITE) ) {}
+    { uint32_t to = RUSB2_SPIN_TIMEOUT; while ( !(rusb->CFIFOSEL & RUSB2_CFIFOSEL_ISEL_WRITE) && --to ) {} }
   } else {
     /* OUT, a byte */
     rusb->CFIFOSEL = RUSB2_FIFOSEL_MBW_8BIT;
-    while ( rusb->CFIFOSEL & RUSB2_CFIFOSEL_ISEL_WRITE ) {}
+    { uint32_t to = RUSB2_SPIN_TIMEOUT; while ( (rusb->CFIFOSEL & RUSB2_CFIFOSEL_ISEL_WRITE) && --to ) {} }
   }
 
   pipe_state_t *pipe = &_dcd.pipe[0];
@@ -480,7 +495,7 @@ static bool process_pipe_xfer(rusb2_reg_t* rusb, int buffer_type, uint8_t ep_add
       rusb->D0FIFOCTR = RUSB2_CFIFOCTR_BVAL_Msk;
