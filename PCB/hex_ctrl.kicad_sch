  (text "Reverse-protected Vin input (J1001), TVS, bulk caps," (at 300 64 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid 8cf386fd-b914-435c-9b8f-d8794efc5347))
  (text "VIN_S divider; pins 2-4 of J1001 = GND / TX / RX" (at 300 67 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid 1ea4d626-0c5f-44e7-af6d-69cc9d55ef57))
  (text "ICM-42688-P on the Nano 3.3 V, SCL/SDA solder pads" (at 45 70 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid 36b69cb7-55ae-4406-a704-ba194eddc910))
