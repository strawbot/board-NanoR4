	(text "Group A = limbs L1+L2, B = L3+L4, C = L5+L6. Each limb holds two antagonist pairs (W1/W2, W3/W4)."
		(exclude_from_sim no)
		(at 200 190 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "186db60a-ceba-4772-89b5-1962ceeac3ba")
	)
	(text "UART header J1: pin 1 GND, pin 2 RX0 (Nano D0 - connect adapter TX), pin 3 TX1 (Nano D1 - connect adapter RX)"
		(exclude_from_sim no)
		(at 30.48 99.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2c9df51d-cf87-4c72-95da-61ac1d150c77")
	)
	(text "Nano R4 pin choices: D9 (RCLK) and D6 (KA) must be GPT timer outputs; D11/D13 hardware SPI. Verify against the Nano R4 pinout."
		(exclude_from_sim no)
		(at 60 50 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "84bd76f8-3476-4f4a-8e07-428231db1df2")
	)
	(text "IMU uses the Nano's 3.3 V Qwiic bus (Wire1) through its through-holes, see IMU sheet. D2 left free for an IMU interrupt if level-shifted later."
		(exclude_from_sim no)
		(at 60 54 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "89f2e36c-5158-4d8a-9cac-140c28b4dd81")
	)
	(text "J2: ARM Cortex 10-pin SWD. VTref = +5V (RA4M1 runs at 5 V). NRST = Nano RESET pin.\nJ3: plated holes under the Nano R4 SWD test points; solder through from the top."
		(exclude_from_sim no)
		(at 30.48 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f0d86893-b8fa-475c-aca1-a29fcf5338b4")
	)
