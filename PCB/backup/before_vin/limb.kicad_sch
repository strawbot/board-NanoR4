	(text "AO3400A pins: 1 G, 2 S, 3 D (SOT-23)."
		(exclude_from_sim no)
		(at 20 26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "03debba0-626e-4acf-ba4c-4b1d8d154470")
	)
	(text "Flyback diodes may be fitted DNP if the wire leads are short. Gate pull-downs keep every MOSFET off when the 74HC595 outputs are disabled."
		(exclude_from_sim no)
		(at 20 22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "57a6519e-a2c8-4457-b9f6-318cc3eca74b")
	)
	(text "Limb: 4 low-side channels. Muscle wire k runs from the +10 V hole to hole Wk. W1/W2 and W3/W4 are the antagonist pairs."
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "688ba9f7-268f-4318-8dc6-e0271604fe2a")
	)
	(text "Gate guard (hardware, no software involved): CAC AC-couples the drive, RPD bleeds it, the BAT54 clamp restores the low level each cycle."
		(exclude_from_sim no)
		(at 20 30 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b40ae20a-c954-4a91-9bf9-34648374ca22")
	)
	(text "Normal pulses (up to ~250 us) pass with a few percent droop; a gate stuck high decays below threshold in ~3 ms (22 nF x 100 k). Use 100 nF with IRLZ34N."
		(exclude_from_sim no)
		(at 20 34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c76500c2-9cbf-437b-919c-6639ca23227b")
	)
