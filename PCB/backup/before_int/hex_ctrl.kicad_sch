  (text "Reverse-protected Vin input (J1001), TVS, bulk caps," (at 300 64 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid 8a055778-ea75-4a6c-9e50-55c8a2b57bff))
  (text "VIN_S divider; pins 2-4 of J1001 = GND / TX / RX" (at 300 67 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid 0ecd176a-19e8-4305-944b-27a7b2adb85d))
  (text "ICM-42688-P on the Nano 3.3 V, SCL/SDA solder pads" (at 45 70 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid a1d4f997-b11a-4a30-be4b-fd6d9005cf72))
  (text "3 x 74HC595 gate-drive chain" (at 42 190 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid 3347cd2d-9359-4e9f-8196-6b27bbf83107))
  (text "(OE tied low)" (at 42 193 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid eefc832b-bfb0-4b7b-9e7e-5355a485f1e8))
  (text "RSENSE + limb_a + limb_b (8 channels)" (at 185.42 177.32 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid b691688b-5919-492b-b8f6-63559088613f))
  (text "RSENSE + limb_a + limb_b (8 channels)" (at 185.42 212.88 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid 387b1292-c2f5-4440-b05e-929df5134255))
  (text "RSENSE + limb_a + limb_b (8 channels)" (at 185.42 248.44 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid 101fbbf8-178c-47db-9d0e-137fd741eaaf))
  (text "Nano R4 pin choices: D9 (RCLK) must be a GPT timer output; D11/D13 hardware SPI. D6 (formerly KA) is now unused. Verify against the Nano R4 pinout." (at 100 40 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 30780cc2-5edc-4368-9f6d-dcc8bb1ae641))
  (text "IMU: 3.3 V and I2C come from the Nano through solder pads under its Qwiic holes (see imu sheet). D2 left free for an IMU interrupt if level-shifted later." (at 100 44 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 9ea6b2a3-75c3-4d77-85a7-239b35d02181))
  (text "No electrical link at this level: TP1202/TP1203 solder to the Nano Qwiic holes; SWD holes TP1204-1208." (at 45 74 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid 4df02ed1-474d-42ad-bfbc-a2d5d020b1c1))
  (text "Group A = limbs L1+L2, B = L3+L4, C = L5+L6. Each limb holds two antagonist pairs (W1/W2, W3/W4)." (at 185 142 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 94593887-f1b5-416b-ad5c-8a68f8ffe77a))
  (text "POWER RAILS (global power symbols, not drawn as wires):" (at 38 262 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid e96bd5bb-456c-4f94-aa0a-40e46a00b33f))
