	(text "Gate guard (hardware, no software involved): CAC AC-couples the drive, RPD bleeds it, the BAT54 clamp restores the low level each cycle."
		(exclude_from_sim no)
		(at 20 30 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0eb39ce8-1ad3-45d8-864b-c0b0b4a4f722")
	)
	(text "Limb: 4 low-side channels. Muscle wire k runs from the Vin hole to hole Wk. W1/W2 and W3/W4 are the antagonist pairs."
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3a965872-c899-4747-997d-365ba3850952")
	)
	(text "AO3400A pins: 1 G, 2 S, 3 D (SOT-23)."
		(exclude_from_sim no)
		(at 20 26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "96a24257-d739-49a4-9b4a-fa6e2dab8ed0")
	)
	(text "Normal pulses (up to ~250 us) pass with a few percent droop; a gate stuck high decays below threshold in ~3 ms (22 nF x 100 k). Use 100 nF with IRLZ34N."
		(exclude_from_sim no)
		(at 20 34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c26e1ff8-0d37-477c-bc70-e827ffbe9f01")
	)
	(text "Flyback diodes may be fitted DNP if the wire leads are short. Gate pull-downs keep every MOSFET off when the 74HC595 outputs are disabled."
		(exclude_from_sim no)
		(at 20 22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d0f6d03f-0d74-4c4b-988f-01d3d85a4fa6")
	)
